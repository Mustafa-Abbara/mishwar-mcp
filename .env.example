# .env — switching model = edit these three lines only
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your-gemini-key
# Local fallback (no key, no quota):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

MCP_TRANSPORT=stdio                 # stdio (dev) | http (demo)
MCP_HTTP_URL=http://127.0.0.1:8000/mcp
MISHWAR_DATA_DIR=data                 # where plans.json lives
MISHWAR_SIMULATE_OUTAGE=0             # 1 = weather service "down" (demo of the failure case)
